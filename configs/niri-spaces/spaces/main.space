# Workspace 1 — system monitor + browser
@workspace 1

# Left: zenith system monitor in ghostty
com.mitchellh.ghostty | ghostty --title="ws1-zenith" -e zenith | | zenith_id

# Right: Brave Origin (whichever variant this machine has)
brave | sh -c 'exec "$(command -v brave-origin || command -v brave-origin-nightly || command -v brave)"' | | brave_id

# 50/50 side by side
@action [ -n "$zenith_id" ] && niri msg action focus-window --id "$zenith_id" && niri msg action set-column-width "50%"
@action [ -n "$brave_id" ] && niri msg action focus-window --id "$brave_id" && niri msg action set-column-width "50%"
