#!/usr/bin/env bash
# lario-fleet — pick a Hermes agent and talk to it, or turn agents on and off.
#
# Bound to Mod+Shift+H (--popup), Mod+Shift+6 (--vision), and the Noctalia bar robot button.
# NOTE: ~/.local/bin/lario-fleet is a COPY, not a symlink. Update both, or the keybind runs
# stale code. `install -m755 bin/lario-fleet ~/.local/bin/lario-fleet`.
#
# Why on/off exists: the fleet shares ONE model on l-dev-ai. Each agent's prompt is ~21k
# tokens, and llama-server caches a prompt prefix per slot. When more agents talk than there
# are slots, prefixes get evicted and every message pays a full cold prefill (~60s) instead of
# a cache hit (~2s). Fewer live agents = more of them stay warm.
#
# `docker stop` alone is NOT enough — boot-fleet.sh runs `docker compose up -d` at every boot
# and would bring it straight back. The durable switch is a `.disabled` marker file in the
# agent's directory, which deploy/lib.sh:hermes_agents() filters on.

set -uo pipefail

AGENTS_REPO="${AGENTS_REPO:-$HOME/Projects/personal/agents}"
MAX_ACTIVE="${LARIO_FLEET_MAX_ACTIVE:-3}"   # refuse to enable more than this many at once

# ─── passthrough modes (unchanged behaviour) ──────────────────────────────────────────────
if [ "${1:-}" == "--popup" ]; then
    exec ghostty -e "$0"
fi

if [ "${1:-}" == "--vision" ]; then
    notify-send "Lario Fleet" "Select region to send to an agent..."
    TARGET_REGION=$(slurp)
    if [ -z "$TARGET_REGION" ]; then exit 1; fi
    TMP_IMG="/tmp/lario_fleet_snap.png"
    grim -g "$TARGET_REGION" "$TMP_IMG"
    exec ghostty -e "$0" "--process-vision" "$TMP_IMG"
fi

if [ "${1:-}" == "--text" ]; then
    SELECTED_TEXT=$(wl-paste --primary)
    if [ -z "$SELECTED_TEXT" ]; then
        SELECTED_TEXT=$(wl-paste)
        if [ -z "$SELECTED_TEXT" ]; then
            notify-send "Lario Fleet" "No text selected in clipboard."
            exit 1
        fi
    fi
    TMP_TXT="/tmp/lario_fleet_text.txt"
    echo "$SELECTED_TEXT" > "$TMP_TXT"
    exec ghostty -e "$0" "--process-text" "$TMP_TXT"
fi

# ─── state helpers ────────────────────────────────────────────────────────────────────────
# Agents come from the REPO, not `docker ps` — a stopped agent must still be listed, or you
# could never turn it back on. Sorted, so menu numbers are stable between runs (the old
# docker-ps ordering shuffled them).
all_agents() {
    local d
    for d in "$AGENTS_REPO"/hermes/*/; do
        [ -f "$d/config.src.yaml" ] && basename "$d"
    done | sort
}
is_disabled() { [ -f "$AGENTS_REPO/hermes/$1/.disabled" ]; }
is_running()  { [ "$(docker inspect -f '{{.State.Running}}' "hermes-$1" 2>/dev/null)" = "true" ]; }
discord_on()  { grep -qE '^\s*enabled:\s*true\s*$' "$AGENTS_REPO/hermes/$1/config.src.yaml" 2>/dev/null; }
active_count() { local n=0 a; for a in $(all_agents); do is_disabled "$a" || n=$((n+1)); done; echo "$n"; }

status_of() {
    local a="$1"
    if is_disabled "$a"; then echo "OFF"
    elif ! is_running "$a"; then echo "ON (stopped)"
    elif discord_on "$a"; then echo "ON  discord"
    else echo "ON  cli-only"
    fi
}

print_fleet() {
    local a s i=1
    echo ""
    echo "====================================="
    echo "        LARIO'S AGENT FLEET          "
    echo "====================================="
    printf "  active: %s/%s\n\n" "$(active_count)" "$MAX_ACTIVE"
    for a in $(all_agents); do
        s=$(status_of "$a")
        printf "  %2d) %-34s %s\n" "$i" "$a" "$s"
        i=$((i+1))
    done
    echo ""
}

pick_agent() {   # prints the chosen agent name on fd 3; menu goes to stderr
    local -a list; mapfile -t list < <(all_agents)
    local n; read -rp "  agent number (blank to cancel): " n
    [ -z "$n" ] && return 1
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "  not a number." >&2; return 1; }
    [ "$n" -ge 1 ] && [ "$n" -le "${#list[@]}" ] || { echo "  out of range." >&2; return 1; }
    printf '%s' "${list[$((n-1))]}"
}

# ─── actions ──────────────────────────────────────────────────────────────────────────────
turn_on() {
    local a="$1"
    if ! is_disabled "$a"; then echo "  $a is already on."; return; fi
    if [ "$(active_count)" -ge "$MAX_ACTIVE" ]; then
        echo "  Cap reached ($MAX_ACTIVE active). Turn one off first — more live agents means"
        echo "  more cache eviction and slower replies for all of them."
        return 1
    fi
    rm -f "$AGENTS_REPO/hermes/$a/.disabled"
    echo "  enabling $a ..."
    ( cd "$AGENTS_REPO" && ./deploy/deploy-hermes.sh "$a" ) 2>&1 | tail -4
}

turn_off() {
    local a="$1"
    if is_disabled "$a"; then echo "  $a is already off."; return; fi
    touch "$AGENTS_REPO/hermes/$a/.disabled"
    echo "  stopping $a ..."
    docker stop "hermes-$a" >/dev/null 2>&1
    echo "  $a is off (marker written; survives reboot)."
}

toggle_discord() {
    local a="$1" cfg="$AGENTS_REPO/hermes/$a/config.src.yaml"
    if discord_on "$a"; then
        sed -i '0,/^\( *\)enabled: true$/s//\1enabled: false/' "$cfg"
        echo "  $a: Discord PAUSED (still reachable via chat)."
    else
        sed -i '0,/^\( *\)enabled: false$/s//\1enabled: true/' "$cfg"
        echo "  $a: Discord ENABLED."
    fi
    if is_disabled "$a"; then
        echo "  (agent is off — takes effect when you turn it on)"
    else
        echo "  redeploying $a ..."
        ( cd "$AGENTS_REPO" && ./deploy/deploy-hermes.sh "$a" ) >/dev/null 2>&1
        docker restart "hermes-$a" >/dev/null 2>&1
        echo "  done."
    fi
}

# Set the terminal/window title. Belt and braces alongside the per-agent Hermes skin:
# the skin names the agent inside the banner, this names it in the window title and taskbar,
# which stays visible after the banner has scrolled away. OSC 0 works in ghostty/xterm.
set_title() { printf '\033]0;%s\007' "$1"; }

chat_with() {
    local a="$1"
    if is_disabled "$a"; then echo "  $a is off — turn it on first."; return 1; fi
    if ! is_running "$a"; then echo "  $a is not running."; return 1; fi
    echo ""
    echo "Connecting to $a..."
    set_title "⚕ $a"
    trap 'set_title "lario-fleet"' RETURN
    # /opt/hermes/bin/hermes is the privilege-drop shim (root -> hermes user). Never wrap this
    # in `sh -lc`: a login shell re-sources /etc/profile and drops hermes off PATH.
    # -it is required; without a TTY the REPL exits immediately printing "Goodbye! ⚕".
    # This starts a NEW agent process — it does not attach to the Discord gateway's session.
    docker exec -it "hermes-$a" /opt/hermes/bin/hermes chat
}

# ─── one-shot payload modes (screenshot / clipboard) ──────────────────────────────────────
if [ "${1:-}" == "--process-vision" ] || [ "${1:-}" == "--process-text" ]; then
    print_fleet
    AGENT=$(pick_agent) || exit 1
    if is_disabled "$AGENT" || ! is_running "$AGENT"; then
        echo "  $AGENT is not running — turn it on first."; sleep 3; exit 1
    fi
    echo ""
    echo "Connecting to $AGENT..."
    set_title "⚕ $AGENT"
    if [ "$1" == "--process-vision" ]; then
        docker cp "$2" "hermes-$AGENT:/tmp/snap.png"
        echo "Sending image and waiting for analysis..."
        docker exec -it "hermes-$AGENT" /opt/hermes/bin/hermes chat \
            -q "Analyze this image from my screen:" --image /tmp/snap.png
    else
        docker cp "$2" "hermes-$AGENT:/tmp/clip.txt"
        echo "Sending text payload..."
        docker exec -it "hermes-$AGENT" bash -c \
            '/opt/hermes/bin/hermes chat -q "Here is a text snippet from my clipboard: $(cat /tmp/clip.txt)"'
    fi
    echo "----------------------------------------"
    echo "Dropping into interactive chat mode..."
    docker exec -it "hermes-$AGENT" /opt/hermes/bin/hermes chat -c
    exit 0
fi

# ─── main menu ────────────────────────────────────────────────────────────────────────────
while true; do
    print_fleet
    echo "  [c] chat   [n] turn on   [f] turn off   [d] toggle discord   [r] refresh   [q] quit"
    read -rp "  > " action
    case "$action" in
        c|C) a=$(pick_agent) && chat_with "$a" ;;
        n|N) a=$(pick_agent) && turn_on "$a" ;;
        f|F) a=$(pick_agent) && turn_off "$a" ;;
        d|D) a=$(pick_agent) && toggle_discord "$a" ;;
        r|R) ;;
        q|Q|"") exit 0 ;;
        *) echo "  unknown option." ;;
    esac
    echo ""
    read -rp "  press Enter to continue..." _
done
